[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/hud.gd" id="1_hud"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="MarginContainer" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 10

[node name="VBox" type="VBoxContainer" parent="MarginContainer"]
layout_mode = 2

[node name="TopRow" type="HBoxContainer" parent="MarginContainer/VBox"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="HeroInfo" type="VBoxContainer" parent="MarginContainer/VBox/TopRow"]
layout_mode = 2

[node name="HeroName" type="Label" parent="MarginContainer/VBox/TopRow/HeroInfo"]
layout_mode = 2
theme_override_colors/font_color = Color(0.22, 0.74, 0.97, 1)
theme_override_font_sizes/font_size = 14
text = "Knight (Paladin)"

[node name="SubText" type="Label" parent="MarginContainer/VBox/TopRow/HeroInfo"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.7, 0.8, 1)
theme_override_font_sizes/font_size = 10
text = "[1-4 / TAB] Switch Hero"

[node name="Bars" type="VBoxContainer" parent="MarginContainer/VBox/TopRow"]
custom_minimum_size = Vector2(160, 0)
layout_mode = 2
theme_override_constants/separation = 4

[node name="HPBar" type="ProgressBar" parent="MarginContainer/VBox/TopRow/Bars"]
custom_minimum_size = Vector2(0, 14)
layout_mode = 2
max_value = 150.0
value = 150.0
show_percentage = false

[node name="HPLabel" type="Label" parent="MarginContainer/VBox/TopRow/Bars/HPBar"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_font_sizes/font_size = 10
text = "HP: 150 / 150"
horizontal_alignment = 1
vertical_alignment = 1

[node name="MPBar" type="ProgressBar" parent="MarginContainer/VBox/TopRow/Bars"]
custom_minimum_size = Vector2(0, 14)
layout_mode = 2
max_value = 50.0
value = 50.0
show_percentage = false

[node name="MPLabel" type="Label" parent="MarginContainer/VBox/TopRow/Bars/MPBar"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_font_sizes/font_size = 10
text = "MP: 50 / 50"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Stats" type="VBoxContainer" parent="MarginContainer/VBox/TopRow"]
layout_mode = 2

[node name="LevelLabel" type="Label" parent="MarginContainer/VBox/TopRow/Stats"]
layout_mode = 2
theme_override_colors/font_color = Color(0.98, 0.85, 0.35, 1)
theme_override_font_sizes/font_size = 12
text = "Lv. 1 (XP: 0)"

[node name="GoldLabel" type="Label" parent="MarginContainer/VBox/TopRow/Stats"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.9, 0.4, 1)
theme_override_font_sizes/font_size = 12
text = "Gold: 0 G"

[node name="ControlsGuide" type="Label" parent="MarginContainer"]
layout_mode = 2
size_flags_horizontal = 8
size_flags_vertical = 0
theme_override_colors/font_color = Color(0.8, 0.85, 0.95, 0.9)
theme_override_font_sizes/font_size = 10
text = "Controls:
[WASD / Arrows] Move
[Space / J] Attack / Spell
[1-4 / TAB] Switch Class"
horizontal_alignment = 2

[node name="GameOverPanel" type="Panel" parent="."]
visible = false
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -140.0
offset_top = -70.0
offset_right = 140.0
offset_bottom = 70.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="GameOverPanel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
alignment = 1

[node name="Title" type="Label" parent="GameOverPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.2, 0.2, 1)
theme_override_font_sizes/font_size = 20
text = "YOU FELL IN BATTLE"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="GameOverPanel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.7, 0.7, 1)
theme_override_font_sizes/font_size = 12
text = "Press R or click Retry to revive"
horizontal_alignment = 1

[node name="RetryBtn" type="Button" parent="GameOverPanel/VBox"]
layout_mode = 2
size_flags_horizontal = 4
text = "  Revive / Retry  "

[connection signal="pressed" from="GameOverPanel/VBox/RetryBtn" to="." method="_on_retry_pressed"]

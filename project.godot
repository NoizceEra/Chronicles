; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but since you are using Antigravity, we configure it cleanly!

config_version=5

[application]

config/name="RPG Quest 2D"
config/description="2D Classic 16-bit RPG with exploration, heroes, monsters, and combat."
run/main_scene="res://scenes/world_25d.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://assets/sprites/knight.png"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.0588235, 0.0901961, 0.164706, 1)

